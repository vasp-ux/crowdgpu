# =============================================================================
# CrowdGPU — Environment Configuration Template
#
# Copy this file to .env and fill in real values for local development.
# NEVER commit a .env file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Coordinator
# -----------------------------------------------------------------------------
COORDINATOR_HOST=0.0.0.0
COORDINATOR_PORT=8000
COORDINATOR_DEBUG=true
COORDINATOR_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crowdgpu
POSTGRES_USER=crowdgpu
POSTGRES_PASSWORD=changeme

# Assembled DSN (coordinator reads this)
DATABASE_URL=postgresql+asyncpg://crowdgpu:changeme@localhost:5432/crowdgpu

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Celery broker / result backend
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Worker Daemon
# -----------------------------------------------------------------------------
WORKER_ID=worker-dev-001
WORKER_MODE=development
WORKER_COORDINATOR_URL=http://localhost:8000
WORKER_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# TURN / Coturn
# -----------------------------------------------------------------------------
TURN_HOST=localhost
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_REALM=crowdgpu.local
TURN_SECRET=changeme-turn-secret

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Security (placeholder — not used in bootstrap)
# -----------------------------------------------------------------------------
SECRET_KEY=changeme-replace-with-a-secure-random-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
