# CrowdGPU Web Portal — environment variables
#
# Copy this file to .env.local and customise for your environment.
# .env.local is gitignored and never committed.
#
# ── VITE_USE_MOCK ─────────────────────────────────────────────────────────────
# Controls mock / demo data mode.
#
# true  → Use local mock data for peers and jobs (recommended during development
#         and project demonstration, because the Coordinator does not yet expose
#         GET /api/v1/peers or any /api/v1/jobs endpoints).
#
# false → Use real Coordinator endpoints. Peers and jobs require the respective
#         backend routes to be implemented. Real errors are shown if endpoints
#         are unavailable — mock data is NOT substituted silently.
#
VITE_USE_MOCK=true

# ── VITE_API_BASE_URL ─────────────────────────────────────────────────────────
# Base URL of the CrowdGPU Coordinator API.
#
# Leave empty (default) to use the Vite dev proxy:
#   /health     → http://localhost:8000/health
#   /api/v1/*   → http://localhost:8000/api/v1/*
#
# Set to a full origin to target a remote Coordinator:
#   VITE_API_BASE_URL=https://coordinator.crowdgpu.example.com
#
# Do NOT include a trailing slash.
# Do NOT include credentials or API keys here.
#
VITE_API_BASE_URL=
